+namespace {
+// Recorded events get their device timestamp copied in by the GPU. Into
+// ordinary (pageable) host memory that copy costs ~300 us on Xe2 (Arc B70);
+// into USM host memory ~10 us. Hand out timestamp slots from USM host slabs,
+// one cache line per slot. Slabs live as long as the process.
+class TimestampSlots {
+  static constexpr size_t SlabBytes = 64 * 1024, Stride = 64;
+  std::mutex Mtx_;
+  std::unordered_map<ze_context_handle_t, std::vector<uint64_t *>> Free_;
+
+public:
+  uint64_t *get(ze_context_handle_t Ctx) {
+    std::lock_guard<std::mutex> Lock(Mtx_);
+    auto &Free = Free_[Ctx];
+    if (Free.empty()) {
+      ze_host_mem_alloc_desc_t Desc = {ZE_STRUCTURE_TYPE_HOST_MEM_ALLOC_DESC};
+      void *Slab = nullptr;
+      if (zeMemAllocHost(Ctx, &Desc, SlabBytes, Stride, &Slab) !=
+              ZE_RESULT_SUCCESS ||
+          !Slab)
+        return nullptr;
+      for (size_t Off = SlabBytes; Off >= Stride; Off -= Stride)
+        Free.push_back(reinterpret_cast<uint64_t *>(
+            static_cast<char *>(Slab) + Off - Stride));
+    }
+    uint64_t *Slot = Free.back();
+    Free.pop_back();
+    *Slot = 0;
+    return Slot;
+  }
+  void put(ze_context_handle_t Ctx, uint64_t *Slot) {
+    std::lock_guard<std::mutex> Lock(Mtx_);
+    Free_[Ctx].push_back(Slot);
+  }
+};
+// Leaked on purpose: events can outlive static destruction.
+TimestampSlots &timestampSlots() {
+  static auto *Slots = new TimestampSlots;
+  return *Slots;
+}
+} // namespace
+
+uint64_t *CHIPEventLevel0::timestampSlot() {
+  if (!TimestampSlot_) {
+    auto *Ctx = static_cast<CHIPContextLevel0 *>(ChipContext_);
+    TimestampSlot_ = timestampSlots().get(Ctx->get());
+    if (!TimestampSlot_)
+      TimestampSlot_ = &TimestampFallback_; // USM allocation failed: slow path
+  }
+  return TimestampSlot_;
+}
