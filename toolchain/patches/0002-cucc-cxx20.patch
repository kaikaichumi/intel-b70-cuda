b70-cuda: let cucc accept -std=c++20 / c++23 (PyTorch 2.13 builds extensions with -std=c++20; clang 22 supports it)

diff --git a/bin/cucc.py b/bin/cucc.py
index 730099e9..58748bb6 100755
--- a/bin/cucc.py
+++ b/bin/cucc.py
@@ -95,7 +95,7 @@ def prepare_argparser() -> argparse.ArgumentParser:
     # nvcc allows -std=c++ mixed with C files which in case the option is
     # ineffective for C files.
     parser.add_argument(
-        '-std', '--std', choices=['c++03', 'c++11', 'c++14', 'c++17', 'c++12'],
+        '-std', '--std', choices=["c++03", "c++11", "c++14", "c++17", "c++20", "c++23", "c++2a", "c++2b", "c++12"],
         help="Specify language standard for CUDA and C++ inputs.")
 
