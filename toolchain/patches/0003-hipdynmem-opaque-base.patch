+  // Intel's IGC (seen with 2.28 and 2.38 on Xe2, SIMD32) mis-addresses
+  // sub-group-uniform local-memory accesses whose offset from the dynamic
+  // shared memory argument folds to a constant immediate in [32 KB, 64 KB):
+  // the values read back are zero. hipCUB BlockReduce/BlockScan storage carved
+  // out of a large extern __shared__ buffer (Mamba's selective scan) hits it.
+  // Routing every use through  arg + (ptrtoint(arg) >> 40)  -- zero at run
+  // time (the raw local pointer is a small SLM window address, 0x10000000 +
+  // offset on Xe2), but not foldable -- keeps the offsets in registers, which
+  // IGC addresses correctly. tests/cuda/scan_transpose_hist.cu and
+  // tests/cuda/cub_block.cu cover both the shift being zero and the bug.
+  static Value *opaqueDynMemArg(Function *F, Argument *DynArg) {
+    BasicBlock &Entry = F->getEntryBlock();
+    std::string Name = (DynArg->getName() + ".opaque").str();
+    for (Instruction &I : Entry)
+      if (I.getName() == Name)
+        return &I;
+    IRBuilder<> B(&Entry, Entry.getFirstNonPHIOrDbgOrAlloca());
+    const DataLayout &DL = F->getParent()->getDataLayout();
+    Type *IntTy = DL.getIntPtrType(DynArg->getType());
+    Value *Addr = B.CreatePtrToInt(DynArg, IntTy, DynArg->getName() + ".addr");
+    Value *Zero = B.CreateLShr(Addr, ConstantInt::get(IntTy, 40), DynArg->getName() + ".zero");
+    return B.CreateGEP(B.getInt8Ty(), DynArg, Zero, Name);
+  }
+
   static void replaceGVarUsesWith(GlobalVariable *GV, Function *F, Value *Repl) {
+    if (Argument *A = dyn_cast<Argument>(Repl))
+      Repl = opaqueDynMemArg(F, A);
